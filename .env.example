# --- Server-side (set in Vercel → Project → Settings → Environment Variables) ---
# Primary (free tier, fast): https://console.groq.com/keys
GROQ_API_KEY=
# Fallback (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: tried first, before the built-in fallbacks (gemini-3.8-flash → 3.5-flash-lite → 3.1-flash-lite)
GEMINI_MODEL=

# --- Client-side (EmailJS: https://dashboard.emailjs.com) ---
# If these are empty the contact form falls back to opening the visitor's mail app.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
